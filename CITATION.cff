    given-names: "Marta"
version: 1.0.0
date-released: 2026-09-22
license: MIT
repository-code: "https://github.com/martamerchan/ficha-maker-redes"
url: "https://martamerchan.github.io/ficha-maker-redes/"
keywords:
  - FabLab
  - fabricación digital
  - cultura maker
  - documentación de proyectos
  - redes sociales
